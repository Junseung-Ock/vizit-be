{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-push-main.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-issue-number.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-work-log.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch-before-edit.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch-before-edit.sh"
          }
        ]
      }
    ]
  }
}
